# Required only for live OpenAI streaming. Without it, JARVIS runs the safe local adapter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Local development services
DATABASE_URL=postgres://jarvis:jarvis@localhost:5432/jarvis
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
JARVIS_DEV_USER_ID=dev-user
JARVIS_DEV_WORKSPACE_ID=dev-workspace
COMPANION_PAIRING_SECRET=replace-with-a-long-random-value
